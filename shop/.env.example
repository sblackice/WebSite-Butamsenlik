# Copy this file to .env and fill in the values. Never commit .env.

# SQLite file for local development (relative to the shop folder).
# For production, switch the schema provider to postgresql and use a Postgres URL.
DATABASE_URL="file:./dev.db"

# Public address of the site (used in password-reset e-mails).
APP_URL="http://localhost:3000"

# Payment provider: "demo" (test only, no money moves) or "none".
# Real providers (e.g. iyzico, PayTR) are NOT integrated yet; see README.
PAYMENT_PROVIDER="demo"

# E-mail delivery for password reset. Leave empty in development:
# the reset link is then printed to the server console.
RESEND_API_KEY=""
MAIL_FROM="Butamsenlik <no-reply@example.com>"
# Set to "console" only for local testing: e-mails are printed to the server log instead of sent.
MAIL_TRANSPORT=""

# First admin account created by `npm run db:seed`. Change before seeding.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="degistir-beni-123"

# Where admin-uploaded images are stored (local disk). Use object storage on serverless hosts.
UPLOAD_DIR="storage/uploads"
